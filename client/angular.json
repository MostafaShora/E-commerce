{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "client": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/client",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/material-theme.scss", "src/styles.css"]
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "client:build:production"
            },
            "development": {
              "buildTarget": "client:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "providersFile": "src/test-providers.ts",
            "exclude": [
              "src/app/core/auth/auth.spec.ts",
              "src/app/features/auth/auth-page/auth-page.spec.ts",
              "src/app/features/auth/login-form/login-form.spec.ts",
              "src/app/features/auth/register-form/register-form.spec.ts",
              "src/app/features/cart/cart-page/cart-page.spec.ts",
              "src/app/features/checkout/checkout-page/checkout-page.spec.ts",
              "src/app/features/home/categories-section/categories-section.spec.ts",
              "src/app/features/home/deals-section/deals-section.spec.ts",
              "src/app/features/home/services/home.spec.ts",
              "src/app/features/orders/order-detail-page/order-detail-page.spec.ts",
              "src/app/features/orders/orders-page/orders-page.spec.ts",
              "src/app/features/product-detail/services/product-detail.spec.ts",
              "src/app/features/products/services/product-detail.spec.ts",
              "src/app/features/reviews/account-reviews/account-reviews.spec.ts"
            ]
          }
        }
      }
    }
  }
}
